# ─── The secret ──────────────────────────────────────────────────────────────
# The one value that never leaves the server before the hour. girl | boy
REVEAL_GENDER=girl

# ─── Database (Turso / libSQL) ───────────────────────────────────────────────
# Leave both empty in development: a local SQLite file is used instead.
# Both are REQUIRED on Vercel — see the README for how to get them.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Optional override ───────────────────────────────────────────────────────
# Overrides "revealAt" in content/reveal.config.json without touching the repo.
# ISO-8601 with an explicit offset. Generate it with: npm run reveal-at
# REVEAL_AT=2026-10-11T20:00:00-03:00
