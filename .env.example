# ─── Database (Turso / libSQL) ───────────────────────────────────────────────
# Leave both empty in development: a local SQLite file (local.db) is used.
# Both are REQUIRED on Vercel — see the README for how to get them.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Retention cron ──────────────────────────────────────────────────────────
# Vercel Cron sends this as a bearer token to /api/cron/purge once a day.
# Any long random string. Optional: reveals past their retention window are
# also purged opportunistically whenever a new one is created.
CRON_SECRET=
